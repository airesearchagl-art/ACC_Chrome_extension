# Autodesk Platform Services (APS) アプリ設定
# Developer Portal: https://aps.autodesk.com/myapps/

APS_CLIENT_ID=your_client_id_here
APS_CLIENT_SECRET=your_client_secret_here
APS_SCOPES=data:read account:read

# サーバーポート
PORT=3000

# 許可する Chrome 拡張機能 ID (省略時は全拡張機能を許可)
# ALLOWED_EXTENSION_ID=abcdefghijklmnopqrstuvwxyzabcdef
